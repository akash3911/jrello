// Prisma 7 Schema for Jrello
// PostgreSQL 15 + PrismaPg Driver Adapter
// Design system: ADR-0001 through ADR-0008

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum IssueStatusKind {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ActivityType {
  ISSUE_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  ASSIGNEE_CHANGED
  ESTIMATE_CHANGED
  DUE_DATE_CHANGED
  SPRINT_ISSUE_ADDED
  SPRINT_ISSUE_REMOVED
  LABEL_ADDED
  LABEL_REMOVED
  COMMENT_ADDED
  BRANCH_CREATED
  PR_OPENED
  PR_MERGED
  PR_CLOSED
  CI_STATUS
  ISSUE_DELETED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  STATUS_CHANGED
}

// --------------------------------------------------------
// Models
// --------------------------------------------------------

// User: Mirrored from Clerk via Webhooks (keyed by clerkId)
model User {
  id                    String            @id @default(uuid()) @db.Uuid
  clerkId               String            @unique
  email                 String            @unique
  name                  String?
  avatarUrl             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspaceMemberships  WorkspaceMember[]
  projectMemberships    ProjectMember[]
  assignedIssues        Issue[]           @relation("IssueAssignee")
  createdIssues         Issue[]           @relation("IssueCreator")
  comments              Comment[]
  activities            Activity[]
  notifications         Notification[]    @relation("NotificationUser")
  actorNotifications    Notification[]    @relation("NotificationActor")

  @@index([clerkId])
  @@index([email])
}

// Workspace: Top-level tenant
model Workspace {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String            @unique
  description           String?
  logoUrl               String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  members               WorkspaceMember[]
  projects              Project[]
  notifications         Notification[]
  githubInstallations   GitHubInstallation[]

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Project: Planning container scoped to workspace
model Project {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  name        String
  key         String          // e.g. "JREL", uppercase 2-10 chars
  slug        String          // URL segment
  description String?
  isPrivate   Boolean         @default(false)
  issueSeq    Int             @default(100) // Transactional counter
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  statuses    IssueStatus[]
  labels      IssueLabel[]
  sprints     Sprint[]
  issues      Issue[]
  githubRepos GitHubRepo[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// IssueStatus: Custom board workflow columns per project
model IssueStatus {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  name      String
  kind      IssueStatusKind
  position  Int             // Column sort order
  isDefault Boolean         @default(false)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([projectId, name])
  @@index([projectId, position])
}

// IssueLabel: Scoped per-project with palette key
model IssueLabel {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  color       String   // palette key
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      IssueLabelAssignment[]

  @@unique([projectId, name])
}

model IssueLabelAssignment {
  issueId String @db.Uuid
  labelId String @db.Uuid

  issue   Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   IssueLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

// Sprint: Time-boxed iteration
model Sprint {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  name      String
  goal      String?
  state     SprintState @default(PLANNED)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId, state])
  @@index([projectId, startDate])
}

// Issue: Atomic work item
model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  number      Int
  title       String
  description String?
  statusId    String        @db.Uuid
  priority    IssuePriority @default(NONE)
  sortOrder   Float
  estimate    Int?
  dueDate     DateTime?
  sprintId    String?       @db.Uuid
  assigneeId  String?       @db.Uuid
  createdById String        @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status       IssueStatus             @relation(fields: [statusId], references: [id], onDelete: Restrict)
  sprint       Sprint?                 @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee     User?                   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("IssueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments     Comment[]
  labels       IssueLabelAssignment[]
  activity     Activity[]
  branches     IssueBranch[]
  pullRequests IssuePullRequest[]
  notifications Notification[]         @relation("NotificationIssue")

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([projectId, sprintId])
  @@index([assigneeId])
  @@index([sortOrder])
}

// Comment: Flat issue comments
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  issueId   String    @db.Uuid
  userId    String    @db.Uuid
  body      String    // markdown
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}

// Activity: Append-only audit and event log
model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  issueId   String       @db.Uuid
  actorId   String?      @db.Uuid
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  issue     Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

// Notification: User inbox
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  workspaceId String           @db.Uuid
  type        NotificationType
  issueId     String?          @db.Uuid
  actorId     String?          @db.Uuid
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issue       Issue?           @relation("NotificationIssue", fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([issueId])
}

// --------------------------------------------------------
// GitHub Integration (Phase 7+)
// --------------------------------------------------------

model GitHubInstallation {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  installationId Int
  accountLogin   String
  accountType    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repos          GitHubRepo[]

  @@unique([workspaceId, installationId])
  @@index([installationId])
}

model GitHubRepo {
  id             String             @id @default(uuid()) @db.Uuid
  installationId String             @db.Uuid
  repoId         Int
  fullName       String
  defaultBranch  String             @default("main")
  projectId      String?            @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  branches       IssueBranch[]
  pullRequests   IssuePullRequest[]

  @@unique([installationId, repoId])
  @@index([projectId])
  @@index([fullName])
}

model IssueBranch {
  id        String     @id @default(uuid()) @db.Uuid
  issueId   String     @db.Uuid
  repoId    String     @db.Uuid
  name      String
  headSha   String?
  createdAt DateTime   @default(now())

  issue     Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  repo      GitHubRepo @relation(fields: [repoId], references: [id], onDelete: Restrict)

  @@unique([repoId, name])
  @@index([issueId])
}

model IssuePullRequest {
  id             String       @id @default(uuid()) @db.Uuid
  issueId        String       @db.Uuid
  repoId         String       @db.Uuid
  number         Int
  title          String
  state          String       // "open" | "closed"
  merged         Boolean      @default(false)
  mergeableState String?
  headSha        String?
  url            String
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  issue          Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  repo           GitHubRepo   @relation(fields: [repoId], references: [id], onDelete: Restrict)
  checks         IssueCheck[]

  @@unique([repoId, number])
  @@index([issueId])
}

model IssueCheck {
  id            String           @id @default(uuid()) @db.Uuid
  pullRequestId String           @db.Uuid
  name          String
  status        String           // "queued" | "in_progress" | "completed"
  conclusion    String?          // "success" | "failure" | "neutral"
  detailsUrl    String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  pullRequest   IssuePullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
}

model GitHubDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @unique
  eventType  String
  receivedAt DateTime @default(now())

  @@index([deliveryId])
}
